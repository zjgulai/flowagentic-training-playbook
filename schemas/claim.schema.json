{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowagentic.example/schemas/claim.schema.json",
  "title": "FlowAgentic research claim",
  "type": "object",
  "required": [
    "claim_id",
    "statement",
    "source_ids",
    "credibility",
    "local_verification",
    "evidence_status",
    "public_safe",
    "applies_to",
    "last_verified",
    "upstream_difference"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-[0-9]{3,}$"
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{3,}$"
      }
    },
    "credibility": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "local_verification": {
      "type": "object",
      "required": ["status", "method", "evidence"],
      "properties": {
        "status": {
          "enum": ["not-started", "blocked", "passed", "failed"]
        },
        "method": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_status": {
      "enum": [
        "proposed",
        "partial",
        "triangulated",
        "verified",
        "rejected",
        "blocked"
      ]
    },
    "public_safe": {
      "type": "boolean"
    },
    "applies_to": {
      "type": "object",
      "required": ["product_version", "release_sha"],
      "properties": {
        "product_version": {
          "type": "string"
        },
        "release_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "upstream_difference": {
      "type": "string"
    },
    "experience_label": {
      "enum": ["system-fact", "official-semantics", "experience-advice", "inference"]
    }
  },
  "additionalProperties": false
}
